{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognition-partner-workshops.example/carddemo/statement.schema.json",
  "title": "CardDemo Statement (DJ-69)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "customer",
    "cardNumber",
    "currentBalance",
    "ficoScore",
    "transactions",
    "totalAmount"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "pattern": "^[0-9]{11}$"
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstName", "lastName", "addressLines"],
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "addressLines": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string" }
        }
      }
    },
    "cardNumber": {
      "type": "string",
      "pattern": "^\\*\\*-\\*\\*-\\*\\*\\*\\*-[0-9]{4}$"
    },
    "currentBalance": { "type": "number" },
    "ficoScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transactionId", "description", "amount"],
        "properties": {
          "transactionId": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "amount": { "type": "number" }
        }
      }
    },
    "totalAmount": { "type": "number" }
  }
}

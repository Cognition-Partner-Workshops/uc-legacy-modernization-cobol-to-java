{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CardRecord",
  "description": "Card master record (CVACT02Y, 150 bytes)",
  "type": "object",
  "properties": {
    "CARD-NUM": {
      "type": "string",
      "maxLength": 16,
      "description": "COBOL PIC X(16) (alpha, 16 bytes)"
    },
    "CARD-ACCT-ID": {
      "type": "integer",
      "description": "COBOL PIC 9(11) (unsigned numeric, 11 digits)"
    },
    "CARD-CVV-CD": {
      "type": "integer",
      "description": "COBOL PIC 9(03) (unsigned numeric, 3 digits)"
    },
    "CARD-EMBOSSED-NAME": {
      "type": "string",
      "maxLength": 50,
      "description": "COBOL PIC X(50) (alpha, 50 bytes)"
    },
    "CARD-EXPIRAION-DATE": {
      "type": "string",
      "maxLength": 10,
      "description": "COBOL PIC X(10) (alpha, 10 bytes)"
    },
    "CARD-ACTIVE-STATUS": {
      "type": "string",
      "maxLength": 1,
      "description": "COBOL PIC X(01) (alpha, 1 bytes)"
    }
  },
  "required": [
    "CARD-NUM",
    "CARD-ACCT-ID",
    "CARD-CVV-CD",
    "CARD-EMBOSSED-NAME",
    "CARD-EXPIRAION-DATE",
    "CARD-ACTIVE-STATUS"
  ],
  "additionalProperties": true
}
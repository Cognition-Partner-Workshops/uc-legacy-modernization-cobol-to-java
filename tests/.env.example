# CardDemo E2E Test Configuration
# Copy this file to .env and update values as needed

BASE_URL=http://localhost:8080
HEADED=false

# Regular user credentials (see CardDemo documentation for defaults)
REGULAR_USER_ID=<your-regular-user-id>
REGULAR_USER_PWD=<your-regular-user-password>

# Admin user credentials (see CardDemo documentation for defaults)
ADMIN_USER_ID=<your-admin-user-id>
ADMIN_USER_PWD=<your-admin-user-password>

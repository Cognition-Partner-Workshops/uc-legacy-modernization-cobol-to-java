{
  "name": "carddemo-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright + Cucumber BDD E2E tests for CardDemo application",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "HEADED=true cucumber-js",
    "test:debug": "PWDEBUG=1 cucumber-js",
    "report": "node -e \"const r=require('multiple-cucumber-html-reporter');r.generate({jsonDir:'./reports',reportPath:'./reports/html'});\"",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@playwright/test": "^1.42.0",
    "playwright": "^1.42.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "multiple-cucumber-html-reporter": "^3.6.2",
    "dotenv": "^16.4.1"
  }
}

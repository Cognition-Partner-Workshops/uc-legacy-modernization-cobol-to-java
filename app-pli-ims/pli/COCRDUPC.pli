 /*********************************************************************/

 COCRDUPC: PROC(IO_PCB_PTR, ALT_PCB_PTR,
                 DB_ACCT_PTR, DB_CARD_PTR,
                 DB_CUST_PTR, DB_CXREF_PTR) OPTIONS(MAIN);

   DCL IO_PCB_PTR    POINTER;
   DCL ALT_PCB_PTR   POINTER;
   DCL DB_ACCT_PTR   POINTER;
   DCL DB_CARD_PTR   POINTER;
   DCL DB_CUST_PTR   POINTER;
   DCL DB_CXREF_PTR  POINTER;

   DCL 1 IO_PCB BASED(IO_PCB_PTR),
         2 IO_LTERM    CHAR(8),  2 IO_RESV  CHAR(2),
         2 IO_STATUS   CHAR(2),  2 IO_DATE  FIXED BIN(31),
         2 IO_TIME     FIXED BIN(31), 2 IO_SEQ FIXED BIN(31),
         2 IO_MOD      CHAR(8);

   DCL 1 ALT_PCB BASED(ALT_PCB_PTR),
         2 ALT_DEST    CHAR(8),  2 ALT_RESV  CHAR(2),
         2 ALT_STATUS  CHAR(2);

   DCL 1 DB_CARD BASED(DB_CARD_PTR),
         2 CARD_DBNAME  CHAR(8),  2 CARD_LEVEL  CHAR(2),
         2 CARD_DBSTAT  CHAR(2),  2 CARD_PROC   CHAR(4),
         2 CARD_RESV    FIXED BIN(31),
         2 CARD_SEGNAME CHAR(8),  2 CARD_KEYLEN FIXED BIN(31),
         2 CARD_SENSEG  FIXED BIN(31),
         2 CARD_KEYVAL  CHAR(256);

   DCL WS_PGMNAME     CHAR(8) INIT('COCRDUPC');
   DCL WS_TRANID      CHAR(4) INIT('CCUP');
   DCL WS_ERR_FLG      CHAR(1) INIT('N');
   DCL WS_RETURN_MSG   CHAR(75) INIT(' ');
   DCL WS_CONFIRM      CHAR(1) INIT('N');

   %INCLUDE COCOM01Y;
   %INCLUDE CVCRD01Y;
   %INCLUDE COTTL01Y;
   %INCLUDE CSDAT01Y;
   %INCLUDE CSMSG01Y;
   %INCLUDE CSMSG02Y;
   %INCLUDE CVACT02Y;
   %INCLUDE CVACT03Y;
   %INCLUDE CSUTLDWY;
   %INCLUDE CSUTLDPY;

   %INCLUDE CSUTIL01Y;
   DCL 1 INPUT_MSG,
         2 LL           FIXED BIN(15),
         2 ZZ           FIXED BIN(15),
         2 TRANCODE     CHAR(8),
         2 IN_CARDNUM   CHAR(16),
         2 IN_ACCTID    CHAR(11),
         2 IN_STATUS    CHAR(1),
         2 IN_EMBNAME   CHAR(50),
         2 IN_EXPDT     CHAR(10),
         2 IN_CONFIRM   CHAR(1),
         2 IN_COMMAREA  CHAR(LENGTH(CARDDEMO_COMMAREA));

   DCL 1 OUTPUT_MSG,
         2 LL           FIXED BIN(15),
         2 ZZ           FIXED BIN(15),
         2 OUT_TRNNAME  CHAR(4),
         2 OUT_TITLE01  CHAR(40),
         2 OUT_CURDATE  CHAR(8),
         2 OUT_PGMNAME  CHAR(8),
         2 OUT_TITLE02  CHAR(40),
         2 OUT_CURTIME  CHAR(8),
         2 OUT_CARDNUM  CHAR(16),
         2 OUT_ACCTID   CHAR(11),
         2 OUT_STATUS   CHAR(1),
         2 OUT_CVV      CHAR(3),
         2 OUT_EMBNAME  CHAR(50),
         2 OUT_EXPDT    CHAR(10),
         2 OUT_CONFIRM  CHAR(1),
         2 OUT_INFOMSG  CHAR(40),
         2 OUT_ERRMSG   CHAR(78);

   DCL CARD_SSA CHAR(50);

   DCL GU   CHAR(4) INIT('GU  ');
   DCL GHU  CHAR(4) INIT('GHU ');
   DCL REPL CHAR(4) INIT('REPL');
   DCL ISRT CHAR(4) INIT('ISRT');
   DCL CHNG CHAR(4) INIT('CHNG');
   DCL PURG CHAR(4) INIT('PURG');
   DCL PLITDLI EXTERNAL ENTRY OPTIONS(ASM INTER);

   /******************************************************************/
   /* MAIN PROCESSING                                                */
   /******************************************************************/
   WS_ERR_FLG = 'N';
   WS_RETURN_MSG = ' ';

   CALL PLITDLI(GU, IO_PCB_PTR, INPUT_MSG);
   CARDDEMO_COMMAREA = IN_COMMAREA;

   /* If card number passed from calling program, use it */
   IF CDEMO_CARD_NUM ^= '' & CDEMO_CARD_NUM ^= ' ' THEN
     IN_CARDNUM = CDEMO_CARD_NUM;

   IF CDEMO_PGM_CONTEXT = '0' THEN DO;
     CDEMO_PGM_CONTEXT = '1';
     IF IN_CARDNUM ^= ' ' THEN DO;
       CALL DISPLAY_CARD_DETAILS;
     END;
     ELSE DO;
       OUT_INFOMSG = 'Enter Card Number to update';
     END;
     CALL SEND_MAP;
   END;
   ELSE DO;
     CALL PROCESS_UPDATE;
   END;

   RETURN;

   /******************************************************************/
   /* DISPLAY_CARD_DETAILS                                           */
   /******************************************************************/
   DISPLAY_CARD_DETAILS: PROC;
     CARD_SSA = 'CARDSEG0(CARDNUM =' || IN_CARDNUM || ')';
     CALL PLITDLI(GU, DB_CARD_PTR, CARD_RECORD, CARD_SSA);

     IF CARD_DBSTAT = '  ' THEN DO;
       OUT_CARDNUM = CARD_NUM;
       OUT_ACCTID  = CARD_ACCT_ID;
       OUT_STATUS  = CARD_ACTIVE_STATUS;
       OUT_CVV     = CARD_CVV_CD;
       OUT_EMBNAME = CARD_EMBOSSED_NAME;
       OUT_EXPDT   = CARD_EXPIRAION_DATE;
       OUT_INFOMSG = 'Update fields and confirm (Y/N)';
     END;
     ELSE DO;
       WS_ERR_FLG = 'Y';
       WS_RETURN_MSG = 'Card not found';
     END;
   END DISPLAY_CARD_DETAILS;

   /******************************************************************/
   /* PROCESS_UPDATE                                                 */
   /******************************************************************/
   PROCESS_UPDATE: PROC;
     IF IN_CARDNUM = ' ' THEN DO;
       WS_RETURN_MSG = 'Card Number is required';
       CALL SEND_MAP;
       RETURN;
     END;

     IF IN_CONFIRM ^= 'Y' & IN_CONFIRM ^= 'y' THEN DO;
       CALL DISPLAY_CARD_DETAILS;
       WS_RETURN_MSG = 'Confirm update with Y to proceed';
       CALL SEND_MAP;
       RETURN;
     END;

     /* Read with hold for update */
     CARD_SSA = 'CARDSEG0(CARDNUM =' || IN_CARDNUM || ')';
     CALL PLITDLI(GHU, DB_CARD_PTR, CARD_RECORD, CARD_SSA);

     IF CARD_DBSTAT ^= '  ' THEN DO;
       WS_RETURN_MSG = 'Card not found for update';
       CALL SEND_MAP;
       RETURN;
     END;

     /* Apply updates */
     IF IN_STATUS ^= ' ' THEN DO;
       IF IN_STATUS = 'Y' | IN_STATUS = 'N' THEN
         CARD_ACTIVE_STATUS = IN_STATUS;
       ELSE DO;
         WS_RETURN_MSG = 'Card status must be Y or N';
         CALL SEND_MAP;
         RETURN;
       END;
     END;

     IF IN_EMBNAME ^= ' ' THEN
       CARD_EMBOSSED_NAME = IN_EMBNAME;

     IF IN_EXPDT ^= ' ' THEN DO;
       /* Validate date */
       WS_EDIT_DATE_CCYYMMDD = IN_EXPDT;
       CALL EDIT_DATE_CCYYMMDD;
       IF WS_DATE_VALIDATION_RESULT ^= 'Y' THEN DO;
         WS_RETURN_MSG = 'Invalid expiration date (CCYYMMDD)';
         CALL SEND_MAP;
         RETURN;
       END;
       CARD_EXPIRAION_DATE = IN_EXPDT;
     END;

     /* Replace the segment */
     CALL PLITDLI(REPL, DB_CARD_PTR, CARD_RECORD);

     IF CARD_DBSTAT = '  ' THEN
       WS_RETURN_MSG = 'Card updated successfully';
     ELSE
       WS_RETURN_MSG = 'Error updating card record';

     CALL DISPLAY_CARD_DETAILS;
     CALL SEND_MAP;
   END PROCESS_UPDATE;

   SEND_MAP: PROC;
     CALL POPULATE_HEADER_INFO;
     OUT_ERRMSG = WS_RETURN_MSG;
     OUTPUT_MSG.LL = SIZE(OUTPUT_MSG);
     OUTPUT_MSG.ZZ = 0;
     IO_MOD = 'COCRDUP';
     CALL PLITDLI(ISRT, IO_PCB_PTR, OUTPUT_MSG);
   END SEND_MAP;
 END COCRDUPC;

               SPA=(128,FIXED)
*
*-----------------------------------------------------------------*
*    BATCH APPLICATION DEFINITIONS                                 *
*-----------------------------------------------------------------*
*
***********************************************************************
*    BATCH - Transaction Posting                                     *
***********************************************************************
         APPLCTN PSB=PCBTRN02,PGMTYPE=BATCH,LANG=PLI,                 X
               SCHDTYP=SERIAL
*
***********************************************************************
*    BATCH - Interest Calculation                                    *
***********************************************************************
         APPLCTN PSB=PCBACT04,PGMTYPE=BATCH,LANG=PLI,                 X
               SCHDTYP=SERIAL
*
***********************************************************************
*    BATCH - Statement Generation                                    *
***********************************************************************
         APPLCTN PSB=PCBSTM03,PGMTYPE=BATCH,LANG=PLI,                 X
               SCHDTYP=SERIAL
*
***********************************************************************
*    BATCH - Transaction Report                                      *
***********************************************************************
         APPLCTN PSB=PCBTRN03,PGMTYPE=BATCH,LANG=PLI,                 X
               SCHDTYP=SERIAL
*
***********************************************************************
*    BATCH - Data Export                                              *
***********************************************************************
         APPLCTN PSB=PCBEXPT,PGMTYPE=BATCH,LANG=PLI,                  X
               SCHDTYP=SERIAL
*
***********************************************************************
*    BATCH - Data Import                                             *
***********************************************************************
         APPLCTN PSB=PCBIMPT,PGMTYPE=BATCH,LANG=PLI,                  X
               SCHDTYP=SERIAL
*
*-----------------------------------------------------------------*
*    DATABASE DEFINITIONS                                          *
*-----------------------------------------------------------------*
*
         DATABASE DBD=DBUSRSEC,ACCESS=UP
         DATABASE DBD=DBACCTDT,ACCESS=UP
         DATABASE DBD=DBCARDDT,ACCESS=UP
         DATABASE DBD=DBCUSTDT,ACCESS=UP
         DATABASE DBD=DBTRANSC,ACCESS=UP
         DATABASE DBD=DBCXREF,ACCESS=UP
         DATABASE DBD=DBCXRIDX,ACCESS=UP
*
         END

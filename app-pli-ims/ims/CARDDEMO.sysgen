***********************************************************************
         APPLCTN PSB=PCOBIL00,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CB00,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(256,FIXED)
*
***********************************************************************
*    USER LIST (Admin)                                               *
***********************************************************************
         APPLCTN PSB=PCOUSR00,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CU00,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=YES,RECOVER=YES,                                   X
               SPA=(128,FIXED)
*
***********************************************************************
*    USER ADD (Admin)                                                *
***********************************************************************
         APPLCTN PSB=PCOUSR01,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CU01,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(128,FIXED)
*
***********************************************************************
*    USER UPDATE (Admin)                                             *
***********************************************************************
         APPLCTN PSB=PCOUSR02,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CU02,PRTY=(7,10,2),MODE=SNGL,                  X

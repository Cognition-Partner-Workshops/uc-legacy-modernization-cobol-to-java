***********************************************************************
*    IMS SYSGEN Macros for CardDemo Application
*    Converted from CICS CSD (CARDDEMO.CSD)
*
*    Maps CICS transaction IDs to IMS transaction codes:
*      CC00 -> CC00  (Signon)
*      CM00 -> CM00  (Main Menu)
*      CA00 -> CA00  (Admin Menu)
*      CAVW -> CAVW  (Account View)
*      CAUP -> CAUP  (Account Update)
*      CCLI -> CCLI  (Card List)
*      CCDL -> CCDL  (Card View/Search)
*      CCUP -> CCUP  (Card Update)
*      CT00 -> CT00  (Transaction List)
*      CT01 -> CT01  (Transaction View)
*      CT02 -> CT02  (Transaction Add)
*      CR00 -> CR00  (Transaction Reports)
*      CB00 -> CB00  (Bill Payment)
*      CU00 -> CU00  (User List)
*      CU01 -> CU01  (User Add)
*      CU02 -> CU02  (User Update)
*      CU03 -> CU03  (User Delete)
***********************************************************************
*
*-----------------------------------------------------------------*
*    ONLINE APPLICATION DEFINITIONS                                *
*-----------------------------------------------------------------*
*
***********************************************************************
*    SIGNON - Entry point for the CardDemo application               *
***********************************************************************
         APPLCTN PSB=PCOSGN00,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CC00,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(128,FIXED)
*
***********************************************************************
*    MAIN MENU - Regular user menu                                   *
***********************************************************************
         APPLCTN PSB=PCOMEN01,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CM00,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(128,FIXED)
*
***********************************************************************
*    ADMIN MENU - Administrator menu                                 *
***********************************************************************
         APPLCTN PSB=PCOADM01,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CA00,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(128,FIXED)
*
***********************************************************************
*    ACCOUNT VIEW                                                    *
***********************************************************************
         APPLCTN PSB=PCOACTVW,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CAVW,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=YES,RECOVER=YES,                                   X
               SPA=(256,FIXED)
*
***********************************************************************
*    ACCOUNT UPDATE                                                  *
***********************************************************************
         APPLCTN PSB=PCOACTUP,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CAUP,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(256,FIXED)
*
***********************************************************************
*    CREDIT CARD LIST                                                *
***********************************************************************
         APPLCTN PSB=PCOCRDLI,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CCLI,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=YES,RECOVER=YES,                                   X
               SPA=(256,FIXED)
*
***********************************************************************
*    CREDIT CARD VIEW/SEARCH                                         *
***********************************************************************
         APPLCTN PSB=PCOCRDSL,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CCDL,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=YES,RECOVER=YES,                                   X
               SPA=(256,FIXED)
*
***********************************************************************
*    CREDIT CARD UPDATE                                              *
***********************************************************************
         APPLCTN PSB=PCOCRDUP,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CCUP,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(256,FIXED)
*
***********************************************************************
*    TRANSACTION LIST                                                *
***********************************************************************
         APPLCTN PSB=PCOTRN00,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CT00,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=YES,RECOVER=YES,                                   X
               SPA=(256,FIXED)
*
***********************************************************************
*    TRANSACTION VIEW                                                *
***********************************************************************
         APPLCTN PSB=PCOTRN01,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CT01,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=YES,RECOVER=YES,                                   X
               SPA=(256,FIXED)
*
***********************************************************************
*    TRANSACTION ADD                                                 *
***********************************************************************
         APPLCTN PSB=PCOTRN02,PGMTYPE=TP,LANG=PLI,                    X
               SCHDTYP=PARALLEL,RESIDENT=NO
         TRANSACT CODE=CT02,PRTY=(7,10,2),MODE=SNGL,                  X
               MSGTYPE=(SNGLSEG,NONRESPONSE),                         X
               INQ=NO,RECOVER=YES,                                    X
               SPA=(256,FIXED)
*
***********************************************************************
*    TRANSACTION REPORTS                                             *
***********************************************************************
